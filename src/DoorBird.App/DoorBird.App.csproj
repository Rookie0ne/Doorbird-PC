<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Bundled FFmpeg shared libraries (LGPL). Populated per runtime identifier by
    scripts/fetch-ffmpeg.sh; copied flat next to the executable so FFmpeg.AutoGen
    finds them via ffmpeg.RootPath. Single-file publish leaves them beside the
    binary, the same way PortAudio's native library already ships.
  -->
  <PropertyGroup>
    <FfmpegRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FfmpegRid>
    <FfmpegRid Condition="'$(FfmpegRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</FfmpegRid>
    <FfmpegNativeDir>$(MSBuildProjectDirectory)/../../native/ffmpeg/$(FfmpegRid)/</FfmpegNativeDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(FfmpegNativeDir)')">
    <Content Include="$(FfmpegNativeDir)*.so.*;$(FfmpegNativeDir)*.dll;$(FfmpegNativeDir)*.dylib;$(FfmpegNativeDir)FFMPEG-LICENSE.txt"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnMissingFfmpeg" BeforeTargets="Build" Condition="!Exists('$(FfmpegNativeDir)')">
    <Warning Text="FFmpeg libraries for $(FfmpegRid) not found at $(FfmpegNativeDir). RTSP mode and recording will be unavailable. Run scripts/fetch-ffmpeg.sh $(FfmpegRid)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoorBird.API\DoorBird.API.csproj" />
  </ItemGroup>
</Project>
